# Copy to .env for local development.
DATABASE_URL=postgres://user:password@localhost:5432/phonetree
# "fake" = no real texts; use /dev (the text simulator) to see and answer them.
SMS_DRIVER=fake
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me
# Who can sign in and gets alerts. Name:number pairs, comma-separated.
PARENT_PHONES=Graham:+15105550100,Susanna:+15105550101

# Needed when SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: send through a Messaging Service instead of the number directly
TWILIO_MESSAGING_SERVICE_SID=
# Calls to the Phone Tree number ring through to this phone
VOICE_FORWARD_TO=
